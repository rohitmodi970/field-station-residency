{
  "expo": {
    "name": "Force Field Station Residency",
    "slug": "force-field-station-residency",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "force-residency",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.force.fieldstationresidency",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Force uses your microphone to record your answers to the three residency questions and display real-time voice ripples."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F6F5F3",
        "foregroundImage": "./assets/images/icon.png"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.force.fieldstationresidency",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Force to access your microphone for voice reflection recording."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
