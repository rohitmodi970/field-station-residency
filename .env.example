# ==============================================================================
# Field Station Residency - Environment Configuration Template
# ==============================================================================

# --- AI Inference (Anthropic Claude) ---
# Primary inference engine for Intent Synthesis, Connection Discovery, Companion Chat, and Footprint Reader
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Supabase Database & Auth ---
# Required for dual-persistence: residency_participants, residency_intent_snapshots, residency_entries, user_context_model
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# --- Speech-to-Text Providers (Multi-tier STT) ---
# Tier 2 Cloud STT: Deepgram Nova-2 (fast, high-precision punctuation and formatting)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Tier 3 Cloud STT: ElevenLabs Scribe v2 (redundant fallback)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# --- Audio Emotion & Multimodal Analysis (Imentiv & Hume) ---
# Imentiv AI emotion analysis service
IMENTIV_API_KEY=your_imentiv_api_key_here
IMENTIV_API_BASE_URL=https://api.imentiv.ai
IMENTIV_WEBHOOK_SECRET=your_imentiv_webhook_secret_here

# Hume AI expression & prosody model
HUME_API_KEY=your_hume_api_key_here

# --- Onairos Behavioral Profile Platform ---
# Client-side OAuth / embed app ID for Onairos user data intake
NEXT_PUBLIC_ONAIROS_APP_ID=your_onairos_app_id_here
NEXT_PUBLIC_RESIDENCY_API=http://localhost:3000
